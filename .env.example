# =============================================================================
# VITRINEFOX - VARIÁVEIS DE AMBIENTE (.env.example)
# =============================================================================

# Porta do servidor Express / Backend (Padrão: 3000)
PORT=3000

# URL pública da aplicação
APP_URL="http://localhost:3000"

# Salt do Servidor para Hash da Senha Administrativa (Gera hashes seguros e não reversíveis)
# NUNCA exponha esta chave ou a senha no código frontend
ADMIN_SALT="vitrinefox_secure_production_salt_change_me"

# =============================================================================
# SUPABASE & POSTGRESQL (OPCIONAL / PRODUÇÃO)
# Obtenha estes valores em: https://supabase.com > Project Settings > API
# =============================================================================
VITE_SUPABASE_URL="https://seu-projeto.supabase.co"
VITE_SUPABASE_ANON_KEY="sua-chave-anon-publica-do-supabase"

# Chave secreta de serviço do Supabase (Apenas se utilizar funções de servidor; NUNCA use com prefixo VITE_)
# SUPABASE_SERVICE_ROLE_KEY="sua-chave-service-role-privada"
